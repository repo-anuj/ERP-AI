// Project Templates for Reusable Project Creation
model ProjectTemplate {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  description          String?
  category             String   // web_development, mobile_app, marketing, construction, etc.
  industry             String   // technology, healthcare, finance, manufacturing, etc.
  type                 String   // internal, client, research, maintenance
  isPublic             Boolean  @default(false) // Available to all companies

  // Template Configuration
  estimatedDuration    Int?     // Days
  estimatedHours       Float?
  defaultBudget        Float?
  priority             String   @default("medium") // low, medium, high
  riskLevel            String   @default("medium") // low, medium, high

  // Template Content
  objectives           String?  // Project objectives
  deliverables         String?  // Key deliverables
  successCriteria      String?  // Success criteria
  notes                String?  // Additional notes
  tags                 String[] // Template tags

  // Predefined Milestones
  milestones           Json[]   // Array of milestone objects

  // Predefined Tasks
  tasks                Json[]   // Array of task templates

  // Required Skills/Roles
  requiredRoles        String[] // Required team roles
  requiredSkills       String[] // Required skills
  teamSize             Int?     // Recommended team size

  // Usage Statistics
  usageCount           Int      @default(0)
  lastUsed             DateTime?

  // Ownership
  companyId            String?  @db.ObjectId // null for public templates
  createdBy            String?  // User who created the template
  createdByName        String?

  // Relations
  templateUsage        TemplateUsage[]

  // Metadata
  version              String   @default("1.0")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([category])
  @@index([industry])
  @@index([isPublic])
  @@index([companyId])
  @@index([isActive])
}

// Template Usage Tracking
model TemplateUsage {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  template     ProjectTemplate @relation(fields: [templateId], references: [id])
  templateId   String          @db.ObjectId
  project      Project         @relation(fields: [projectId], references: [id])
  projectId    String          @db.ObjectId
  companyId    String          @db.ObjectId
