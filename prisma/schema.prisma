// General audit log for tracking all system changes
model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  // Who performed the action
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?  @db.ObjectId
  userEmail   String?  // Fallback if user is deleted
  userName    String?  // User name at time of action

  // What was done
  action      String   // CREATE, UPDATE, DELETE, APPROVE, REJECT, etc.
  entityType  String   // EMPLOYEE, LEAVE_APPLICATION, PERFORMANCE_REVIEW, etc.
  entityId    String   // ID of the affected entity

  // Additional context
  details     Json?    // Flexible JSON field for action-specific details
  changes     Json?    // Before/after values for updates
  ipAddress   String?  // IP address of the user
  userAgent   String?  // Browser/client information

  // Company context
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String   @db.ObjectId

  // Timestamps
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([performedAt])
}

