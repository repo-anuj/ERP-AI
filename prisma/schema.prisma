datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "debian-openssl-1.1.x", "linux-musl"]
}

model User {
  id                   String         @id @default(auto()) @map("_id") @db.ObjectId
  email                String         @unique
  password             String
  firstName            String?
  lastName             String?
  image                String?
  bio                  String?
  role                 String?
  location             String?
  darkMode             Boolean        @default(false)
  compactView          Boolean        @default(false)
  onboardingCompleted  Boolean        @default(false)
  company              Company?       @relation(fields: [companyId], references: [id])
  companyId            String?        @db.ObjectId
  notifications        Notification[]
  transactions         Transaction[]
  pushSubscriptions    PushSubscription[]
  auditLogs            AuditLog[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Company {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  legalName         String?
  address           String?
  phone             String?
  email             String?
  website           String?
  logo              String?
  defaultCurrency   String              @default("USD")

  // Enhanced onboarding fields
  onboardingStep    Int                @default(0)
  onboardingCompleted Boolean          @default(false)
  onboardingData    Json?              // Store all onboarding responses

  // Business configuration
  businessType      String?            // manufacturing, service, retail, consulting, technology, healthcare, education, agriculture, logistics, finance
  businessModel     String?            // b2b, b2c, b2b2c, marketplace, saas
  companyStage      String?            // startup, growing, established, enterprise
  primaryGoal       String?            // inventory_management, sales_tracking, employee_management, financial_control, project_management, all_in_one
  industry          String?            // Detailed industry classification

  // Branding & Identity
  brandColors       Json?              // { primary: "#color", secondary: "#color", accent: "#color" }
  companyStamp      String?            // URL to company stamp image
  tagline           String?
  socialMedia       Json?              // { linkedin, twitter, facebook, instagram }

  // Legal & Financial
  taxId             String?            // GST number, EIN, VAT number, etc.
  businessRegistrationNumber String?
  vatNumber         String?
  panNumber         String?            // India specific
  einNumber         String?            // US specific
  gstNumber         String?            // India specific
  businessLicense   String?
  fiscalYearStart   String?            // "April" or "January"
  accountingMethod  String?            // "cash" or "accrual"

  // Location & Operations
  country           String?
  state             String?
  city              String?
  zipCode           String?
  timezone          String?
  language          String?            @default("en")
  operatingHours    Json?              // Weekly schedule with open/close times
  workingDays       String[]           // ["monday", "tuesday", ...]
  holidays          Json?              // Array of holiday dates and names

  // Business Operations
  manufacturingDetails Json?           // Production capacity, machinery, certifications
  serviceDetails    Json?              // Service types, areas, appointment duration
  retailDetails     Json?              // Store locations, POS system, online store

  // Financial Configuration
  bankAccounts      Json?              // Array of bank account details
  paymentMethods    Json?              // Accepted payment methods
  payrollFrequency  String?            // weekly, biweekly, monthly
  payrollProvider   String?

  // Integrations
  paymentGateways   Json?              // Payment gateway configurations
  emailProvider     Json?              // Email service configuration
  smsProvider       Json?              // SMS service configuration
  cloudStorage      Json?              // Cloud storage configuration

  // Dashboard & UI configuration
  dashboardConfig   Json?              // User's dashboard layout and widgets
  featureToggles    Json?              // Enabled/disabled features

  // Existing relations
  users             User[]
  inventory         InventoryItem[]
  employees         Employee[]
  customers         Customer[]
  sales             Sale[]
  projects          Project[]
  transactions      Transaction[]
  budgetCategories  BudgetCategory[]
  financialAccounts FinancialAccount[]
  recurringSchedules RecurringSchedule[]
  budgets           Budget[]
  attendance        Attendance[]
  approvalWorkflows ApprovalWorkflow[]
  idProofTypes      IdProofType[] // Company-specific ID proof types
  departments       Department[]
  locations         Location[]
  vehicles          Vehicle[]

  // Reward System Relations
  rewardTypes       RewardType[]
  badges            Badge[]
  achievements      Achievement[]
  rewards           Reward[]

  // Attendance Relations
  attendancePolicies AttendancePolicy[]
  shifts            Shift[]

  // Leave Relations
  leaveTypes        LeaveType[]
  leaveApplications LeaveApplication[]
  employeeLeaveBalances EmployeeLeaveBalance[]

  // Performance Relations
  performanceTemplates PerformanceTemplate[]
  performanceReviews   PerformanceReview[]
  performanceGoals     PerformanceGoal[]
  performanceFeedbacks PerformanceFeedback[]

  // Payroll Relations
  salaryStructures  SalaryStructure[]
  payrolls          Payroll[]
  payslips          Payslip[]
  taxCalculations   TaxCalculation[]
  taxDeclarations   TaxDeclaration[]
  form16s           Form16[]
  bankFiles         BankFile[]

  // Recruitment & Onboarding Relations
  jobPostings       JobPosting[]
  candidates        Candidate[]
  jobApplications   JobApplication[]
  interviews        Interview[]
  candidateEvaluations CandidateEvaluation[]
  offers            Offer[]
  onboardingWorkflows OnboardingWorkflow[]
  onboardingInstances OnboardingInstance[]
  backgroundChecks  BackgroundCheck[]
  recruitmentMetrics RecruitmentMetrics[]

  // Audit Relations
  auditLogs         AuditLog[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  message     String
  type        String   // budget-alert, budget-created, sale-created, transaction-created, etc.
  read        Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @db.ObjectId
  entityId    String?  @db.ObjectId // ID of the related entity (budget, sale, etc.)
  entityType  String?  // Type of the related entity (budget, sale, transaction, etc.)
  actionType  String?  // created, updated, deleted, etc.
  actorName   String?  // Name of the user who performed the action
  metadata    String?  // Additional JSON data
  link        String?  // Link to the related entity
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([read])
  @@index([entityType, entityId])
}

model PushSubscription {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @db.ObjectId
  endpoint   String
  p256dhKey  String
  authKey    String
  userAgent  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([isActive])
}

model InventoryItem {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  sku          String
  category     String
  quantity     Int
  price        Float
  status       String
  description  String?
  reorderPoint Int          @default(10)
  company      Company      @relation(fields: [companyId], references: [id])
  companyId    String       @db.ObjectId
  location     Location?    @relation(fields: [locationId], references: [id])
  locationId   String?      @db.ObjectId
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId])
  @@index([locationId])
}

model Employee {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName  String
  lastName   String
  email      String   @unique
  phone      String?
  position   String

  // Department and Location relationships
  department Department? @relation(fields: [departmentId], references: [id])
  departmentId String?   @db.ObjectId
  location   Location?   @relation(fields: [locationId], references: [id])
  locationId String?     @db.ObjectId

  startDate  DateTime
  salary     Float?
  status     String   @default("active")
  password   String?  // Added for employee login
  role       String   @default("employee") // employee, admin, manager
  permissions String[] // Array of permissions
  lastLogin  DateTime?

  // Extended profile information
  employeeId String?  // Badge/Employee ID number
  avatar     String?  // Profile picture URL
  dateOfBirth DateTime?
  gender     String?  // male, female, other, prefer_not_to_say
  maritalStatus String? // single, married, divorced, widowed
  nationality String?

  // Contact Information
  personalEmail String?
  alternatePhone String?
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelation String?

  // Address Information
  address    EmployeeAddress?

  // Professional Information
  jobTitle   String?
  workLocation String?
  manager    String? // Employee ID of manager
  hireDate   DateTime? // Different from startDate for rehires
  probationEndDate DateTime?
  contractType String? // permanent, contract, temporary, intern
  workType   String? // full_time, part_time, contract, freelance

  // Education & Skills
  education  EducationRecord[]
  skills     String[] // Array of skills
  certifications CertificationRecord[]

  // Financial Information
  bankAccountNumber String?
  bankName         String?
  bankRoutingNumber String?
  taxId            String?

  // Work Authorization
  workAuthorizationStatus String? // citizen, permanent_resident, visa, other
  visaType               String?
  visaExpiryDate         DateTime?

  // Additional Information
  bio        String?
  notes      String? // Internal HR notes
  documents  EmployeeDocument[]
  idProofs   EmployeeIdProof[] // Encrypted ID proofs

  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String   @db.ObjectId
  sales      Sale[]
  attendance Attendance[]
  chatMessages ProjectChat[]

  // Reward System Relations
  rewards      Reward[]
  badges       EmployeeBadge[]
  achievements EmployeeAchievement[]
  points       EmployeePoints?

  // Attendance Relations
  attendancePolicy   AttendancePolicy? @relation(fields: [attendancePolicyId], references: [id])
  attendancePolicyId String?           @db.ObjectId
  shifts             EmployeeShift[]

  // Leave Relations
  leaveApplications  LeaveApplication[]
  leaveBalances      EmployeeLeaveBalance[]

  // Performance Relations
  performanceReviews PerformanceReview[]
  performanceGoals   PerformanceGoal[]
  performanceFeedbacks PerformanceFeedback[]

  // Payroll Relations
  salaryStructures  SalaryStructure[]
  payrolls          Payroll[]
  payslips          Payslip[]
  taxCalculations   TaxCalculation[]
  taxDeclarations   TaxDeclaration[]
  form16s           Form16[]

  // Onboarding Relations
  onboardingInstances OnboardingInstance[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([departmentId])
  @@index([locationId])
  @@index([role])
  @@index([employeeId])
}

model Attendance {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String   @db.ObjectId
  date       DateTime @default(now())
  checkIn    DateTime?
  checkOut   DateTime?
  status     String   @default("present") // present, absent, late, half-day, leave, holiday
  notes      String?

  // Enhanced tracking
  totalHours    Float?   // Total hours worked
  overtimeHours Float?   // Overtime hours
  breakDuration Float?   // Break time in hours
  isLate        Boolean  @default(false)
  isEarlyLeave  Boolean  @default(false)

  // Location tracking
  checkInLocation  String? // GPS coordinates or location name
  checkOutLocation String?

  // Approval workflow
  approvedBy    String?  @db.ObjectId // Manager who approved
  approvedAt    DateTime?
  isApproved    Boolean  @default(true)

  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([companyId])
  @@index([date])
  @@index([status])
}

model AttendancePolicy {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String   // "Standard Policy", "Flexible Hours", etc.
  description       String?

  // Work schedule
  workingDays       String[] // ["monday", "tuesday", "wednesday", "thursday", "friday"]
  startTime         String   // "09:00"
  endTime           String   // "17:00"
  breakDuration     Float    @default(1.0) // Break time in hours

  // Attendance rules
  lateThreshold     Int      @default(15) // Minutes after start time considered late
  halfDayThreshold  Float    @default(4.0) // Hours required for half day
  fullDayThreshold  Float    @default(8.0) // Hours required for full day
  overtimeThreshold Float    @default(8.0) // Hours after which overtime starts

  // Rewards integration
  perfectAttendancePoints Int @default(50) // Points for perfect monthly attendance
  earlyArrivalPoints     Int @default(5)  // Points for arriving early

  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  company           Company  @relation(fields: [companyId], references: [id])
  companyId         String   @db.ObjectId

  // Employees using this policy
  employees         Employee[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
  @@index([isDefault])
}

model Shift {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   // "Morning Shift", "Night Shift", etc.
  startTime   String   // "09:00"
  endTime     String   // "17:00"
  description String?

  // Shift details
  isActive    Boolean  @default(true)
  color       String?  // For calendar display

  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String   @db.ObjectId

  // Employee shift assignments
  employeeShifts EmployeeShift[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model EmployeeShift {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String   @db.ObjectId
  shift      Shift    @relation(fields: [shiftId], references: [id])
  shiftId    String   @db.ObjectId

  // Schedule details
  startDate  DateTime
  endDate    DateTime?
  daysOfWeek String[] // ["monday", "tuesday", "wednesday"]

  isActive   Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([shiftId])
  @@index([startDate])
}

// ============================================================================
// LEAVE MANAGEMENT MODELS
// ============================================================================

model LeaveType {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String   // "Annual Leave", "Sick Leave", "Personal Leave"
  description       String?

  // Leave configuration
  maxDaysPerYear    Int      @default(20) // Maximum days allowed per year
  carryOverDays     Int      @default(5)  // Days that can be carried to next year
  minNoticeRequired Int      @default(1)  // Minimum days notice required
  maxConsecutiveDays Int?    // Maximum consecutive days allowed

  // Approval requirements
  requiresApproval  Boolean  @default(true)
  approvalLevels    Int      @default(1) // Number of approval levels required

  // Accrual settings
  accrualRate       Float    @default(1.67) // Days accrued per month
  accrualStartDate  String   @default("hire_date") // "hire_date" or "year_start"

  // Leave rules
  allowHalfDays     Boolean  @default(true)
  allowNegativeBalance Boolean @default(false)
  isActive          Boolean  @default(true)

  company           Company  @relation(fields: [companyId], references: [id])
  companyId         String   @db.ObjectId

  // Leave applications
  leaveApplications LeaveApplication[]
  employeeLeaveBalances EmployeeLeaveBalance[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
  @@index([isActive])
}

model LeaveApplication {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  employee        Employee  @relation(fields: [employeeId], references: [id])
  employeeId      String    @db.ObjectId
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])
  leaveTypeId     String    @db.ObjectId

  // Leave details
  startDate       DateTime
  endDate         DateTime
  totalDays       Float     // Support for half days (0.5, 1.0, 1.5, etc.)
  reason          String
  isHalfDay       Boolean   @default(false)
  halfDayPeriod   String?   // "morning" or "afternoon"

  // Application status
  status          String    @default("pending") // "pending", "approved", "rejected", "cancelled"
  appliedAt       DateTime  @default(now())

  // Approval workflow
  approvals       LeaveApproval[]
  currentApprovalLevel Int  @default(1)

  // Additional details
  emergencyContact String?
  workHandover     String?   // Work handover notes
  attachments      String[]  // File URLs for medical certificates, etc.

  company         Company   @relation(fields: [companyId], references: [id])
  companyId       String    @db.ObjectId

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([companyId])
  @@index([status])
  @@index([startDate])
}

model LeaveApproval {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  leaveApplication  LeaveApplication @relation(fields: [leaveApplicationId], references: [id])
  leaveApplicationId String          @db.ObjectId

  // Approval details
  approverLevel     Int              // 1, 2, 3, etc.
  approverId        String?          @db.ObjectId // Manager/HR who approved
  approverName      String?          // Name of approver
  approverEmail     String?          // Email of approver

  status            String           @default("pending") // "pending", "approved", "rejected"
  comments          String?          // Approval/rejection comments
  approvedAt        DateTime?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([leaveApplicationId])
  @@index([approverId])
  @@index([status])
}

model EmployeeLeaveBalance {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  employee        Employee  @relation(fields: [employeeId], references: [id])
  employeeId      String    @db.ObjectId
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])
  leaveTypeId     String    @db.ObjectId

  // Balance tracking
  year            Int       // Leave year (e.g., 2024)
  totalEntitled   Float     // Total days entitled for the year
  totalUsed       Float     @default(0) // Total days used
  totalPending    Float     @default(0) // Total days in pending applications
  carryOver       Float     @default(0) // Days carried over from previous year

  // Calculated fields
  availableBalance Float    @default(0) // totalEntitled + carryOver - totalUsed - totalPending

  // Accrual tracking
  lastAccrualDate DateTime?
  nextAccrualDate DateTime?

  company         Company   @relation(fields: [companyId], references: [id])
  companyId       String    @db.ObjectId

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([companyId])
  @@index([year])
}

// ============================================================================
// PERFORMANCE MANAGEMENT MODELS
// ============================================================================

model PerformanceTemplate {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String   // "Annual Review", "Quarterly Check-in", "Probation Review"
  description       String?

  // Template configuration
  reviewType        String   @default("annual") // "annual", "quarterly", "monthly", "probation", "custom"
  frequency         String   @default("yearly") // "yearly", "quarterly", "monthly", "one-time"
  duration          Int      @default(30) // Review period in days

  // Review sections and criteria
  sections          Json     // Array of review sections with criteria
  ratingScale       Json     // Rating scale configuration (1-5, 1-10, etc.)

  // Workflow settings
  selfReviewEnabled Boolean  @default(true)
  managerReviewEnabled Boolean @default(true)
  peerReviewEnabled Boolean  @default(false)
  skipLevelReviewEnabled Boolean @default(false)

  // Automation settings
  autoAssignReviews Boolean  @default(false)
  reminderSettings  Json?    // Reminder configuration

  isActive          Boolean  @default(true)
  isDefault         Boolean  @default(false)

  company           Company  @relation(fields: [companyId], references: [id])
  companyId         String   @db.ObjectId

  // Performance reviews using this template
  performanceReviews PerformanceReview[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
  @@index([isActive])
  @@index([isDefault])
}

model PerformanceReview {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  employee          Employee @relation(fields: [employeeId], references: [id])
  employeeId        String   @db.ObjectId
  template          PerformanceTemplate @relation(fields: [templateId], references: [id])
  templateId        String   @db.ObjectId

  // Review period
  reviewPeriodStart DateTime
  reviewPeriodEnd   DateTime
  reviewType        String   // "annual", "quarterly", "monthly", "probation"

  // Review status
  status            String   @default("draft") // "draft", "in_progress", "pending_approval", "completed", "cancelled"
  overallRating     Float?   // Overall performance rating
  overallComments   String?  // Manager's overall comments

  // Review participants
  reviewerId        String?  @db.ObjectId // Primary reviewer (usually manager)
  reviewerName      String?
  reviewerEmail     String?

  // Review completion tracking
  selfReviewCompleted Boolean @default(false)
  managerReviewCompleted Boolean @default(false)
  finalReviewCompleted Boolean @default(false)

  // Important dates
  dueDate           DateTime
  completedAt       DateTime?

  company           Company  @relation(fields: [companyId], references: [id])
  companyId         String   @db.ObjectId

  // Related data
  goals             PerformanceGoal[]
  feedbacks         PerformanceFeedback[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([employeeId])
  @@index([templateId])
  @@index([companyId])
  @@index([status])
  @@index([dueDate])
}

model PerformanceGoal {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  employee          Employee @relation(fields: [employeeId], references: [id])
  employeeId        String   @db.ObjectId
  performanceReview PerformanceReview? @relation(fields: [reviewId], references: [id])
  reviewId          String?  @db.ObjectId

  // Goal details
  title             String
  description       String
  category          String   @default("performance") // "performance", "development", "behavioral", "project"
  priority          String   @default("medium") // "low", "medium", "high", "critical"

  // SMART goal criteria
  isSpecific        Boolean  @default(false)
  isMeasurable      Boolean  @default(false)
  isAchievable      Boolean  @default(false)
  isRelevant        Boolean  @default(false)
  isTimeBound       Boolean  @default(false)

  // Goal tracking
  targetValue       Float?   // Target metric value
  currentValue      Float?   // Current progress value
  unit              String?  // Unit of measurement
  progressPercent   Float    @default(0) // Progress percentage (0-100)

  // Timeline
  startDate         DateTime
  targetDate        DateTime
  completedDate     DateTime?

  // Status and outcome
  status            String   @default("active") // "active", "completed", "cancelled", "on_hold"
  achievementLevel  String?  // "exceeded", "met", "partially_met", "not_met"
  finalComments     String?

  company           Company  @relation(fields: [companyId], references: [id])
  companyId         String   @db.ObjectId

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([employeeId])
  @@index([reviewId])
  @@index([companyId])
  @@index([status])
  @@index([targetDate])
}

model PerformanceFeedback {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  employee          Employee @relation(fields: [employeeId], references: [id])
  employeeId        String   @db.ObjectId
  performanceReview PerformanceReview? @relation(fields: [reviewId], references: [id])
  reviewId          String?  @db.ObjectId

  // Feedback details
  feedbackType      String   // "self", "manager", "peer", "skip_level", "subordinate", "360"
  feedbackCategory  String   // "strengths", "areas_for_improvement", "achievements", "goals", "general"

  // Feedback content
  rating            Float?   // Numerical rating if applicable
  comments          String   // Feedback comments
  isAnonymous       Boolean  @default(false)

  // Feedback provider
  providerId        String?  @db.ObjectId // ID of person providing feedback
  providerName      String?  // Name of feedback provider
  providerEmail     String?  // Email of feedback provider
  providerRole      String?  // Role/relationship to employee

  // Feedback status
  status            String   @default("draft") // "draft", "submitted", "reviewed", "acknowledged"
  isVisible         Boolean  @default(true) // Whether feedback is visible to employee

  company           Company  @relation(fields: [companyId], references: [id])
  companyId         String   @db.ObjectId

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([employeeId])
  @@index([reviewId])
  @@index([companyId])
  @@index([feedbackType])
  @@index([status])
}

model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String?
  phone     String?
  address   String?
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String   @db.ObjectId
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Sale {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String?
  customer      Customer   @relation(fields: [customerId], references: [id])
  customerId    String     @db.ObjectId
  employee      Employee?  @relation(fields: [employeeId], references: [id])
  employeeId    String?    @db.ObjectId
  date          DateTime
  status        String
  total         Float
  tax           Float?
  notes         String?
  items         SaleItem[]
